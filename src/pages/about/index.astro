---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const processSteps = [
  {
    num: '01',
    title: '諮詢溝通',
    desc: '透過電話或線上表單與我們聯繫，討論你想要的拍攝風格、造型需求，並確認拍攝日期。我們會仔細聆聽你的需求，提供專業建議。',
  },
  {
    num: '02',
    title: '造型準備',
    desc: '拍攝當天，專業造型師為你打造適合的妝髮造型。我們也提供多套工作室禮服供選擇，讓你以最佳狀態面對鏡頭。',
  },
  {
    num: '03',
    title: '拍攝進行',
    desc: '在攝影師的引導下，於精心布置的場景中完成拍攝。過程輕鬆自然，不用擔心姿勢問題，我們會引導你展現最好的一面。',
  },
  {
    num: '04',
    title: '後期修圖',
    desc: '拍攝後進行專業後製調色與精修，所有照片以雲端連結交付，方便下載與分享。每張照片都經過細心處理，呈現最完美的效果。',
  },
];

const equipmentList = [
  { icon: 'camera', title: '專業器材', desc: '使用高階相機與鏡頭組合，搭配專業棚燈、柔光箱與反光板，確保每張照片的最佳品質。' },
  { icon: 'sun', title: '自然光場景', desc: '攝影棚設有大面積採光窗，自然光與人造光可靈活搭配，創造豐富多變的光影效果。' },
  { icon: 'layers', title: '多樣背景', desc: '從簡約純色到風格化場景，我們持續更新攝影棚布置，讓每次拍攝都有新鮮感。' },
];
---

<Layout
  title="關於我們 | 請進攝影棚"
  description="認識請進攝影棚 — 基隆專業攝影工作室。從2018年成立至今，提供個人寫真、孕婦寫真、情侶寫真、全家福等專業攝影服務。位於基隆火車站附近，是唯一提供租棚服務的攝影工作室。"
>
  <Navbar />

  <main>
    <!-- ========== SECTION 1: HERO ========== -->
    <section class="relative w-full min-h-[60vh] flex items-end overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img
          src="/studio-interior.jpg"
          alt="請進攝影棚工作室內部"
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>
      <!-- Overlay -->
      <div
        class="absolute inset-0 z-[1]"
        style="background: linear-gradient(to top, #0A0A0A 0%, rgba(10,10,10,0.6) 50%, rgba(10,10,10,0.3) 100%);"
      >
      </div>
      <!-- Content -->
      <div class="relative z-[2] w-full max-w-[1440px] mx-auto px-6 lg:px-20 pb-16 lg:pb-20">
        <p class="reveal font-sans-tc text-[11px] tracking-[0.15em] text-[#D4A574] uppercase mb-3">
          ABOUT
        </p>
        <h1 class="text-reveal font-serif-tc text-[32px] lg:text-[56px] text-[#F5F0EB] font-normal leading-[1.2] tracking-[0.01em] mb-4">
          關於請進攝影棚
        </h1>
        <p class="reveal font-sans-tc text-base text-[#A09A94] font-light max-w-md" style="transition-delay: 0.7s;">
          用光與影，書寫你的故事
        </p>
        <div class="gold-line mt-6 inline-block" />
      </div>
    </section>

    <!-- ========== SECTION 2: PHILOSOPHY ========== -->
    <section class="relative bg-[#0A0A0A] py-20 lg:py-[150px]">
      <!-- Vertical Section Label -->
      <div class="hidden lg:block absolute left-8 top-1/2 -translate-y-1/2">
        <span class="section-label">VISION</span>
      </div>

      <div class="max-w-[1000px] mx-auto px-6 lg:px-20 text-center">
        <!-- Opening Statement -->
        <h2 class="text-reveal font-serif-tc text-[28px] lg:text-[42px] text-[#F5F0EB] font-light leading-[1.3] tracking-[0.01em] mb-6">
          一張照片能保存什麼？
        </h2>
        <div class="gold-line mx-auto mb-12 lg:mb-16" style="--line-width: 60px;" />

        <!-- Philosophy Paragraphs -->
        <div class="max-w-[700px] mx-auto space-y-8">
          <p class="reveal font-sans-tc text-base text-[#A09A94] font-light leading-[1.9] text-center" style="transition-delay: 0.5s;">
            在請進攝影棚，我們相信每一次拍攝都是一場關於發現的旅程。發現你未曾察覺的美，發現愛人眼中最真實的你，發現時光裡那些稍縱即逝卻值得永恆保存的瞬間。
          </p>
          <p class="reveal font-sans-tc text-base text-[#A09A94] font-light leading-[1.9] text-center" style="transition-delay: 0.58s;">
            我們的攝影棚位於基隆火車站附近，交通便利。棚內布置精緻，多樣風格場景搭配自然光照射，讓每一位走進來的客人都能找到自己心中的畫面。
          </p>
          <p class="reveal font-sans-tc text-base text-[#A09A94] font-light leading-[1.9] text-center" style="transition-delay: 0.66s;">
            從2018年成立至今，我們堅持用專業的態度與親切的服務，為無數家庭、情侶、個人留下了珍貴的影像記憶。
          </p>
        </div>

        <!-- Signature -->
        <p class="reveal font-caveat text-xl text-[#D4A574] mt-12" style="transition-delay: 1.0s;">
          — 請進攝影棚團隊
        </p>
      </div>
    </section>

    <!-- ========== SECTION 3: PROCESS ========== -->
    <section class="relative bg-[#141414] py-20 lg:py-[150px]">
      <!-- Vertical Section Label -->
      <div class="hidden lg:block absolute left-8 top-1/2 -translate-y-1/2">
        <span class="section-label">PROCESS</span>
      </div>

      <div class="max-w-[1200px] mx-auto px-6 lg:px-20">
        <!-- Header -->
        <div class="text-center mb-12 lg:mb-16">
          <h2 class="reveal font-serif-tc text-[28px] lg:text-[42px] text-[#F5F0EB] font-normal leading-[1.3] mb-4">
            拍攝流程
          </h2>
          <p class="reveal font-sans-tc text-base text-[#A09A94] font-light" style="transition-delay: 0.1s;">
            簡單四步，輕鬆擁有專業寫真
          </p>
        </div>

        <!-- Process Steps Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {processSteps.map((step, i) => (
            <div
              class="reveal relative bg-[#0A0A0A] p-8 lg:p-10"
              style={`transition-delay: ${0.3 + i * 0.1}s;`}
            >
              <!-- Gold top accent line -->
              <div class="absolute top-0 left-10 w-[30px] h-[2px] bg-[#D4A574]" />
              
              <!-- Step number -->
              <span class="font-playfair text-[48px] text-[#D4A574] opacity-30 leading-none block mb-4">
                {step.num}
              </span>
              
              <!-- Step title -->
              <h3 class="font-serif-tc text-[22px] text-[#F5F0EB] font-normal mb-3">
                {step.title}
              </h3>
              
              <!-- Step description -->
              <p class="font-sans-tc text-sm text-[#A09A94] font-light leading-[1.7]">
                {step.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========== SECTION 4: EQUIPMENT & SPACE ========== -->
    <section class="relative bg-[#0A0A0A] py-20 lg:py-[150px]">
      <!-- Vertical Section Label -->
      <div class="hidden lg:block absolute left-8 top-1/2 -translate-y-1/2">
        <span class="section-label">SPACE</span>
      </div>

      <div class="max-w-[1200px] mx-auto px-6 lg:px-20">
        <!-- Header -->
        <div class="mb-12 lg:mb-16">
          <h2 class="reveal font-serif-tc text-[28px] lg:text-[42px] text-[#F5F0EB] font-normal leading-[1.3] mb-4">
            攝影空間
          </h2>
          <p class="reveal font-sans-tc text-base text-[#A09A94] font-light" style="transition-delay: 0.1s;">
            專業設備 × 精緻場景 × 自然光線
          </p>
        </div>

        <!-- Row 1: Image + Text side by side -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-12 lg:mb-16">
          <!-- Equipment Image -->
          <div class="reveal overflow-hidden" style="transition-delay: 0.2s;">
            <img
              src="/equipment-detail.jpg"
              alt="專業攝影器材與燈光設備"
              class="w-full aspect-[16/10] object-cover"
              loading="lazy"
            />
          </div>
          <!-- Text Content -->
          <div class="flex flex-col justify-center">
            <h3 class="reveal font-serif-tc text-[22px] lg:text-[28px] text-[#F5F0EB] font-normal mb-4" style="transition-delay: 0.3s;">
              基隆唯一租棚服務
            </h3>
            <p class="reveal font-sans-tc text-base text-[#A09A94] font-light leading-[1.8] mb-6" style="transition-delay: 0.38s;">
              我們的攝影棚提供專業的租棚服務，配備完整的燈光設備與多樣背景場景，適合攝影師、網紅、創作者前來取景拍攝。
            </p>
            <ul class="space-y-2">
              <li class="reveal font-sans-tc text-sm text-[#A09A94] font-light" style="transition-delay: 0.46s;">
                <span class="text-[#D4A574] mr-2">•</span>多種風格場景，定期更新
              </li>
              <li class="reveal font-sans-tc text-sm text-[#A09A94] font-light" style="transition-delay: 0.54s;">
                <span class="text-[#D4A574] mr-2">•</span>專業燈光設備齊全
              </li>
              <li class="reveal font-sans-tc text-sm text-[#A09A94] font-light" style="transition-delay: 0.62s;">
                <span class="text-[#D4A574] mr-2">•</span>自然光充足
              </li>
              <li class="reveal font-sans-tc text-sm text-[#A09A94] font-light" style="transition-delay: 0.70s;">
                <span class="text-[#D4A574] mr-2">•</span>化妝更衣空間
              </li>
            </ul>
          </div>
        </div>

        <!-- Row 2: Feature Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {equipmentList.map((item, i) => (
            <div
              class="reveal bg-[#141414] p-8 lg:p-10"
              style={`transition-delay: ${0.3 + i * 0.1}s;`}
            >
              <!-- Icon -->
              <div class="mb-4">
                {item.icon === 'camera' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D4A574" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                    <circle cx="12" cy="13" r="4"/>
                  </svg>
                )}
                {item.icon === 'sun' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D4A574" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"/>
                    <line x1="12" y1="1" x2="12" y2="3"/>
                    <line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1" y1="12" x2="3" y2="12"/>
                    <line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                  </svg>
                )}
                {item.icon === 'layers' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D4A574" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                  </svg>
                )}
              </div>
              <!-- Title -->
              <h4 class="font-serif-tc text-lg text-[#F5F0EB] font-normal mb-3">
                {item.title}
              </h4>
              <!-- Description -->
              <p class="font-sans-tc text-sm text-[#A09A94] font-light leading-[1.7]">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========== SECTION 5: PHOTOGRAPHER PROFILE ========== -->
    <section class="relative bg-[#141414] py-20 lg:py-[150px]">
      <!-- Vertical Section Label -->
      <div class="hidden lg:block absolute left-8 top-1/2 -translate-y-1/2">
        <span class="section-label">TEAM</span>
      </div>

      <div class="max-w-[1000px] mx-auto px-6 lg:px-20 text-center">
        <!-- Header -->
        <h2 class="reveal font-serif-tc text-[28px] lg:text-[42px] text-[#F5F0EB] font-normal leading-[1.3] mb-12 lg:mb-16">
          認識攝影師
        </h2>

        <!-- Portrait -->
        <div class="reveal mx-auto mb-6 overflow-hidden border border-[rgba(212,165,116,0.15)]" style="max-width: 280px; transition-delay: 0.2s;">
          <img
            src="/photographer-profile.jpg"
            alt="請進攝影棚攝影師"
            class="w-full h-[350px] object-cover"
            loading="lazy"
          />
        </div>

        <!-- Name -->
        <h3 class="text-reveal font-serif-tc text-[22px] lg:text-[28px] text-[#F5F0EB] font-normal mb-2" style="transition-delay: 0.5s;">
          請進攝影團隊
        </h3>

        <!-- Role -->
        <p class="reveal font-sans-tc text-sm text-[#D4A574] mb-6" style="transition-delay: 0.7s;">
          專業攝影師 & 造型師
        </p>

        <!-- Bio -->
        <p class="reveal font-sans-tc text-base text-[#A09A94] font-light leading-[1.8] max-w-[560px] mx-auto mb-8" style="transition-delay: 0.9s;">
          我們是請進攝影棚的攝影與造型團隊，熱愛用鏡頭捕捉每個人獨特的美。多年來的拍攝經驗讓我們深知，最好的照片來自最真實的情感流露。我們會在輕鬆愉快的氛圍中引導你，讓你展現最自然、最自信的一面。
        </p>

        <!-- Instagram CTA -->
        <a
          href="https://www.instagram.com/come.0507"
          target="_blank"
          rel="noopener noreferrer"
          class="reveal inline-flex items-center gap-2 text-[#D4A574] hover:underline transition-colors duration-400"
          style="transition-delay: 1.1s;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="5"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          <span class="font-caveat text-lg">@come.0507</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .gold-line::after {
    left: 50%;
    transform: translateX(-50%);
  }
  .gold-line.revealed::after {
    width: 60px;
  }
</style>
