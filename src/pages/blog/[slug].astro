    { slug: 'pet-photography-tips', title: '寵物攝影技巧：如何捕捉毛孩最可愛的瞬間', date: '2024.11.18', category: 'tips', categoryLabel: '攝影技巧', readingTime: '5 分鐘', image: '/gallery-pet.jpg', description: '寵物不聽話、到處亂跑？專業寵物攝影師分享捕捉毛孩最佳表情的秘訣，從誘導技巧到快門時機一次告訴你。', tags: ['寵物攝影','毛孩','拍攝技巧','寵物寫真'], author: { name: '王凱文', role: '寵物攝影師', bio: '動物行為學背景，擅長與各種寵物溝通，讓牠們在鏡頭前展現最可愛的一面。' } },
    { slug: 'friend-portrait-outfit-guide', title: '閨蜜寫真穿搭指南：這樣搭配最上鏡', date: '2024.11.10', category: 'guide', categoryLabel: '拍攝指南', readingTime: '5 分鐘', image: '/hero-portrait.jpg', description: '閨蜜寫真的穿搭秘訣：色系的搭配、風格的統一與對比，讓你們的照片既有個人特色又充滿默契感。', tags: ['閨蜜寫真','穿搭指南','人像攝影','閨蜜照'], author: { name: '林小雅', role: '首席攝影師', bio: '擅長閨蜜與團體人像拍攝，認為最好的照片來自真實的友誼互動。' } },
    { slug: 'couple-photography-poses', title: '情侶寫真的浪漫姿勢：自然互動最重要', date: '2024.11.03', category: 'guide', categoryLabel: '拍攝指南', readingTime: '6 分鐘', image: '/gallery-couple.jpg', description: '最動人的情侶照不是擺出來的，而是自然互動中抓拍的。這些引導技巧幫助情侶在鏡頭前展現最真實的愛意。', tags: ['情侶寫真','情侶照','拍攝姿勢','愛情攝影'], author: { name: '林小雅', role: '首席攝影師', bio: '相信真實的情感比完美的姿勢更動人，擅長捕捉情侶間最自然的互動瞬間。' } },
    { slug: 'studio-rental-first-timer-guide', title: '攝影棚租借須知：第一次租棚要注意什麼？', date: '2024.10.28', category: 'behind', categoryLabel: '幕後花絮', readingTime: '7 分鐘', image: '/studio-interior.jpg', description: '第一次租借攝影棚？從場地選擇、器材準備到時間規劃，這篇完整指南讓你的租棚體驗順利又高效。', tags: ['攝影棚','租棚','攝影器材','新手須知'], author: { name: '陳大維', role: '攝影技術顧問', bio: '負責攝影棚的技術規劃與器材維護，熟悉各類拍攝需求與場地運用。' } },
  ];

  return posts.map((post, index) => {
    const sameCategory = posts.filter(p => p.category === post.category && p.slug !== post.slug);
    const otherPosts = posts.filter(p => p.category !== post.category && p.slug !== post.slug);
    const relatedPosts = [...sameCategory, ...otherPosts].slice(0, 3);
    const prevPost = index > 0 ? { slug: posts[index - 1].slug, title: posts[index - 1].title } : null;
    const nextPost = index < posts.length - 1 ? { slug: posts[index + 1].slug, title: posts[index + 1].title } : null;
    const content = articles[post.slug] || '<p>文章內容載入中...</p>';
    return {
      params: { slug: post.slug },
      props: { post: { ...post, content }, prevPost, nextPost, relatedPosts },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const pageTitle = `${post.title} | 攝影日誌 | 請進攝影棚`;
const pageDescription = post.description;
const pageImage = post.image;

// Generate structured data for this article
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.description,
  "image": `https://comeinphotostudio.com${post.image}`,
  "datePublished": post.date.replace(/\./g, '-'),
  "author": {
    "@type": "Person",
    "name": post.author.name,
    "jobTitle": post.author.role
  },
  "publisher": {
    "@type": "Organization",
    "name": "請進攝影棚",
    "logo": {
      "@type": "ImageObject",
      "url": "https://comeinphotostudio.com/hero-portrait.jpg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://comeinphotostudio.com/blog/${post.slug}/`
  }
};
---

<Layout title={pageTitle} description={pageDescription} image={pageImage}>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  </slot>

  <Navbar />

  <!-- Article Header Hero -->
  <section class="relative w-full min-h-[70vh] flex items-end overflow-hidden">
    <img
      src={post.image}
      alt={post.title}
      class="absolute inset-0 w-full h-full object-cover object-center img-blur-load"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, #0A0A0A 0%, rgba(10,10,10,0.5) 60%, rgba(10,10,10,0.3) 100%);"></div>
    <div class="relative z-10 w-full max-w-[900px] mx-auto pb-16 md:pb-20 px-6 md:px-0">
      <a href="/blog/" class="inline-block font-sans-tc text-[13px] text-[#A09A94] hover:text-[#D4A574] transition-colors duration-300 mb-8 reveal">
        &larr; 返回日誌
      </a>
      <p class="font-sans-tc text-[11px] tracking-[0.15em] text-[#D4A574] mb-3 reveal reveal-delay-1">
        {post.categoryLabel}
      </p>
      <h1 class="font-serif-tc text-[28px] md:text-[48px] text-[#F5F0EB] font-normal leading-[1.2] mb-4 text-reveal" style="letter-spacing: 0.01em;">
        {post.title}
      </h1>
      <div class="w-[60px] h-px bg-[#D4A574] mb-4 gold-line"></div>
      <p class="font-sans-tc text-[13px] text-[#6B6560] reveal reveal-delay-2">
        {post.date} &middot; {post.readingTime}閱讀
      </p>
    </div>
  </section>

  <!-- Article Body -->
  <article class="bg-[#0A0A0A] py-16 md:py-20 px-6">
    <div class="max-w-[720px] mx-auto article-body">
      <Fragment set:html={post.content} />
    </div>
  </article>

  <!-- Article Footer -->
  <section class="bg-[#0A0A0A] pb-16 md:pb-20 px-6">
    <div class="max-w-[720px] mx-auto border-t border-[rgba(245,240,235,0.06)] pt-10">
      <!-- Tags -->
      <div class="mb-8 reveal">
        <span class="font-sans-tc text-[13px] text-[#6B6560] mr-2">標籤：</span>
        <div class="inline-flex flex-wrap gap-2 mt-2">
          {post.tags.map(tag => (
            <span class="font-sans-tc text-xs text-[#A09A94] border border-[rgba(245,240,235,0.1)] px-3 py-1 hover:border-[#D4A574] hover:text-[#D4A574] transition-colors duration-300 cursor-default">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Author Box -->
      <div class="bg-[#141414] p-8 mb-12 reveal">
        <div class="flex items-start gap-5">
          <div class="w-16 h-16 rounded-full bg-[#1A1A1A] flex items-center justify-center flex-shrink-0">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A574" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div>
            <p class="font-serif-tc text-base text-[#F5F0EB] mb-1">{post.author.name}</p>
            <p class="font-sans-tc text-[13px] text-[#6B6560] mb-3">{post.author.role}</p>
            <p class="font-sans-tc text-sm text-[#A09A94] leading-relaxed">{post.author.bio}</p>
          </div>
        </div>
      </div>

      <!-- Prev / Next Navigation -->
      <div class="flex items-stretch justify-between gap-4 border-t border-[rgba(245,240,235,0.06)] pt-8 reveal">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}/`} class="flex-1 group text-left">
            <span class="block font-sans-tc text-xs text-[#6B6560] mb-2">&larr; 上一篇</span>
            <span class="font-serif-tc text-sm text-[#A09A94] group-hover:text-[#D4A574] transition-colors duration-300 line-clamp-2">
              {prevPost.title}
            </span>
          </a>
        ) : <div class="flex-1"></div>}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}/`} class="flex-1 group text-right">
            <span class="block font-sans-tc text-xs text-[#6B6560] mb-2">下一篇 &rarr;</span>
            <span class="font-serif-tc text-sm text-[#A09A94] group-hover:text-[#D4A574] transition-colors duration-300 line-clamp-2">
              {nextPost.title}
            </span>
          </a>
        ) : <div class="flex-1"></div>}
      </div>
    </div>
  </section>

  <!-- Related Articles -->
  <section class="bg-[#141414] py-16 md:py-24 px-6 lg:px-20">
    <div class="max-w-[1200px] mx-auto">
      <h2 class="font-serif-tc text-[28px] text-[#F5F0EB] font-normal mb-4 reveal">繼續閱讀</h2>
      <div class="w-10 h-px bg-[#D4A574] mb-12 reveal"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedPosts.map((rp, i) => (
          <a href={`/blog/${rp.slug}/`} class="blog-card group block reveal" style={`transition-delay: ${i * 0.1}s`}>
            <div class="overflow-hidden">
              <img src={rp.image} alt={rp.title} class="w-full aspect-[3/2] object-cover img-blur-load transition-transform duration-700 group-hover:scale-[1.03]" />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <span class="font-sans-tc text-xs text-[#6B6560]">{rp.date}</span>
                <span class="w-1 h-1 rounded-full bg-[#D4A574]"></span>
                <span class="font-sans-tc text-xs text-[#D4A574]">{rp.categoryLabel}</span>
              </div>
              <h3 class="font-serif-tc text-lg text-[#F5F0EB] font-normal leading-snug group-hover:text-[#D4A574] transition-colors duration-300 line-clamp-2">
                {rp.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />

  <style>
    .article-body :global(.lead) {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 300;
      color: #A09A94;
      line-height: 1.7;
      margin-bottom: 40px;
      letter-spacing: 0.01em;
    }
    .article-body :global(h2) {
      font-family: 'Noto Serif TC', serif;
      font-size: 32px;
      font-weight: 400;
      color: #F5F0EB;
      line-height: 1.3;
      margin-top: 64px;
      margin-bottom: 24px;
      border-left: 2px solid #D4A574;
      padding-left: 16px;
      letter-spacing: 0.01em;
    }
    .article-body :global(h3) {
      font-family: 'Noto Serif TC', serif;
      font-size: 24px;
      font-weight: 400;
      color: #F5F0EB;
      line-height: 1.4;
      margin-top: 48px;
      margin-bottom: 16px;
      letter-spacing: 0.01em;
    }
    .article-body :global(p) {
      font-family: 'Noto Sans TC', sans-serif;
      font-size: 17px;
      font-weight: 300;
      color: #C8C3BE;
      line-height: 1.9;
      margin-bottom: 24px;
    }
    .article-body :global(blockquote) {
      position: relative;
      border-left: 2px solid #D4A574;
      padding-left: 24px;
      margin: 40px 0;
      font-family: 'Noto Serif TC', serif;
      font-size: 22px;
      font-weight: 400;
      color: #D4A574;
      line-height: 1.6;
    }
    .article-body :global(blockquote cite) {
      display: block;
      font-family: 'Noto Sans TC', sans-serif;
      font-size: 13px;
      color: #6B6560;
      margin-top: 12px;
      font-style: normal;
    }
    .article-body :global(ul) {
      margin: 24px 0;
      padding-left: 24px;
      list-style: none;
    }
    .article-body :global(ul li) {
      font-family: 'Noto Sans TC', sans-serif;
      font-size: 16px;
      font-weight: 300;
      color: #C8C3BE;
      line-height: 1.8;
      margin-bottom: 12px;
      position: relative;
      padding-left: 20px;
    }
    .article-body :global(ul li::before) {
      content: '\2022';
      position: absolute;
      left: 0;
      color: #D4A574;
    }
    .article-body :global(ol) {
      margin: 24px 0;
      padding-left: 24px;
    }
    .article-body :global(ol li) {
      font-family: 'Noto Sans TC', sans-serif;
      font-size: 16px;
      font-weight: 300;
      color: #C8C3BE;
      line-height: 1.8;
      margin-bottom: 12px;
      padding-left: 8px;
    }
    .article-body :global(ol li::marker) {
      font-family: 'Playfair Display', serif;
      color: #D4A574;
    }
    .article-body :global(a) {
      color: #D4A574;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.3s;
    }
    .article-body :global(a:hover) {
      border-bottom-color: #D4A574;
    }
    .article-body :global(hr) {
      border: none;
      border-top: 1px solid rgba(245,240,235,0.06);
      margin: 64px 0;
    }
    .article-body :global(strong) {
      font-weight: 400;
      color: #F5F0EB;
    }
    .article-body :global(.tip-box) {
      background: #141414;
      border-left: 2px solid #D4A574;
      padding: 24px 28px;
      margin: 32px 0;
    }
    .article-body :global(.tip-box-title) {
      font-family: 'Noto Sans TC', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: #D4A574;
      margin-bottom: 12px;
      letter-spacing: 0.05em;
    }
    .article-body :global(.tip-box p) {
      margin-bottom: 0;
      font-size: 15px;
    }
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    @media (max-width: 768px) {
      .article-body :global(h2) { font-size: 24px; margin-top: 48px; }
      .article-body :global(h3) { font-size: 20px; }
      .article-body :global(.lead) { font-size: 18px; }
    }
  </style>
</Layout>